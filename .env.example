# AI Branding Chatbot - AWS-Only Architecture
# Streamlit runs locally, all backend services use AWS
# Copy this file to .env and fill in your values

# Environment (always 'dev' for development)
ENVIRONMENT=dev
LOG_LEVEL=INFO
DEV_PROFILE=true  # Set to false for production/hackathon submission
USE_AGENTCORE=true  # Enable Bedrock AgentCore orchestration

# Amazon Bedrock 설정 (Primary LLM Provider)
BEDROCK_REGION=us-west-2
CLAUDE_MODEL_ID=us.anthropic.claude-sonnet-4-20250514-v1:0
SDXL_MODEL_ID=amazon.titan-image-generator-v2:0  # Updated to Titan Image Generator v2
IMAGE_MODEL_ID=amazon.titan-image-generator-v2:0  # Alias for SDXL_MODEL_ID
BEDROCK_KB_ID=  # Optional: Bedrock Knowledge Base ID
BEDROCK_AGENT_ID=  # Optional: Bedrock Agent ID for AgentCore
BEDROCK_AGENT_ALIAS_ID=  # Optional: Bedrock Agent Alias ID
ENABLE_FALLBACK=true  # Set to false for production/hackathon submission

# Bedrock Retry Configuration (Exponential Backoff)
BEDROCK_MAX_RETRIES=3
BEDROCK_BASE_DELAY=1.0  # Base delay in seconds for exponential backoff
BEDROCK_MAX_DELAY=30.0  # Maximum delay cap in seconds
BEDROCK_TIMEOUT=30
BEDROCK_MAX_TOKENS=2048
BEDROCK_TEMPERATURE=0.7

# Fallback Provider 설정 (Development only)
FALLBACK_PROVIDER=openai  # Options: openai, gemini

# OpenAI API 설정 (Fallback only when ENABLE_FALLBACK=true)
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_SECRET_NAME=openai-api-key
OPENAI_MODEL=gpt-4
OPENAI_DALLE_MODEL=dall-e-3

# Gemini API 설정 (Fallback only when ENABLE_FALLBACK=true)
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-pro
GEMINI_VISION_MODEL=gemini-pro-vision

# AWS Configuration
AWS_REGION=us-west-2
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key

# API Gateway (deployed endpoint)
API_BASE_URL=https://your-api-id.execute-api.us-west-2.amazonaws.com/dev

# DynamoDB (AWS service)
SESSIONS_TABLE=ai-branding-chatbot-sessions

# S3 (AWS service)
S3_BUCKET=ai-branding-chatbot-assets-908601828278

# Fallback Images
FALLBACK_IMAGES_BASE_URL=https://via.placeholder.com/1024x1024/4A90E2/FFFFFF?text=