# Environment Configuration for AI Branding Chatbot

# AWS Configuration
AWS_REGION=us-west-2
ENVIRONMENT=production

# API Gateway Endpoint (replace with your actual endpoint after deployment)
API_BASE_URL=https://your-api-id.execute-api.us-west-2.amazonaws.com/dev

# Bedrock Configuration
BEDROCK_REGION=us-west-2
CLAUDE_MODEL_ID=us.anthropic.claude-sonnet-4-20250514-v1:0
SDXL_MODEL_ID=amazon.titan-image-generator-v2:0

# Feature Flags
ENABLE_FALLBACK=false
USE_AGENTCORE=true

# Optional: AWS Credentials (if not using IAM roles)
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key
