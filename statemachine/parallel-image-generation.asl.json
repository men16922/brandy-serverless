{
  "Comment": "Parallel AI image generation workflow for signboard designs",
  "StartAt": "ParallelImageGeneration",
  "States": {
    "ParallelImageGeneration": {
      "Type": "Parallel",
      "Comment": "Generate signboard images using multiple AI providers in parallel",
      "Branches": [
        {
          "StartAt": "GenerateWithDALLE",
          "States": {
            "GenerateWithDALLE": {
              "Type": "Task",
              "Resource": "arn:aws:states:::lambda:invoke",
              "Parameters": {
                "FunctionName": "${SignboardAgentFunction}",
                "Payload": {
                  "provider": "dalle",
                  "sessionId.$": "$.sessionId",
                  "selectedName.$": "$.selectedName",
                  "businessInfo.$": "$.businessInfo",
                  "style.$": "$.styles[0]",
                  "action": "generate_single"
                }
              },
              "ResultPath": "$.dalleResult",
              "TimeoutSeconds": 30,
              "Retry": [
                {
                  "ErrorEquals": ["States.TaskFailed", "States.Timeout"],
                  "IntervalSeconds": 2,
                  "MaxAttempts": 2,
                  "BackoffRate": 2.0
                }
              ],
              "Catch": [
                {
                  "ErrorEquals": ["States.ALL"],
                  "Next": "DALLEFallback",
                  "ResultPath": "$.error"
                }
              ],
              "End": true
            },
            "DALLEFallback": {
              "Type": "Pass",
              "Comment": "Fallback for DALL-E generation failure",
              "Result": {
                "provider": "dalle",
                "status": "fallback",
                "image": {
                  "url": "https://fallback-images.s3.amazonaws.com/dalle-fallback.png",
                  "provider": "dalle",
                  "style": "modern",
                  "is_fallback": true
                }
              },
              "ResultPath": "$.dalleResult",
              "End": true
            }
          }
        },
        {
          "StartAt": "GenerateWithSDXL",
          "States": {
            "GenerateWithSDXL": {
              "Type": "Task",
              "Resource": "arn:aws:states:::lambda:invoke",
              "Parameters": {
                "FunctionName": "${SignboardAgentFunction}",
                "Payload": {
                  "provider": "sdxl",
                  "sessionId.$": "$.sessionId",
                  "selectedName.$": "$.selectedName",
                  "businessInfo.$": "$.businessInfo",
                  "style.$": "$.styles[1]",
                  "action": "generate_single"
                }
              },
              "ResultPath": "$.sdxlResult",
              "TimeoutSeconds": 30,
              "Retry": [
                {
                  "ErrorEquals": ["States.TaskFailed", "States.Timeout"],
                  "IntervalSeconds": 2,
                  "MaxAttempts": 2,
                  "BackoffRate": 2.0
                }
              ],
              "Catch": [
                {
                  "ErrorEquals": ["States.ALL"],
                  "Next": "SDXLFallback",
                  "ResultPath": "$.error"
                }
              ],
              "End": true
            },
            "SDXLFallback": {
              "Type": "Pass",
              "Comment": "Fallback for SDXL generation failure",
              "Result": {
                "provider": "sdxl",
                "status": "fallback",
                "image": {
                  "url": "https://fallback-images.s3.amazonaws.com/sdxl-fallback.png",
                  "provider": "sdxl",
                  "style": "classic",
                  "is_fallback": true
                }
              },
              "ResultPath": "$.sdxlResult",
              "End": true
            }
          }
        },
        {
          "StartAt": "GenerateWithGemini",
          "States": {
            "GenerateWithGemini": {
              "Type": "Task",
              "Resource": "arn:aws:states:::lambda:invoke",
              "Parameters": {
                "FunctionName": "${SignboardAgentFunction}",
                "Payload": {
                  "provider": "gemini",
                  "sessionId.$": "$.sessionId",
                  "selectedName.$": "$.selectedName",
                  "businessInfo.$": "$.businessInfo",
                  "style.$": "$.styles[2]",
                  "action": "generate_single"
                }
              },
              "ResultPath": "$.geminiResult",
              "TimeoutSeconds": 30,
              "Retry": [
                {
                  "ErrorEquals": ["States.TaskFailed", "States.Timeout"],
                  "IntervalSeconds": 2,
                  "MaxAttempts": 2,
                  "BackoffRate": 2.0
                }
              ],
              "Catch": [
                {
                  "ErrorEquals": ["States.ALL"],
                  "Next": "GeminiFallback",
                  "ResultPath": "$.error"
                }
              ],
              "End": true
            },
            "GeminiFallback": {
              "Type": "Pass",
              "Comment": "Fallback for Gemini generation failure",
              "Result": {
                "provider": "gemini",
                "status": "fallback",
                "image": {
                  "url": "https://fallback-images.s3.amazonaws.com/gemini-fallback.png",
                  "provider": "gemini",
                  "style": "vibrant",
                  "is_fallback": true
                }
              },
              "ResultPath": "$.geminiResult",
              "End": true
            }
          }
        }
      ],
      "Next": "MergeResults"
    },
    "MergeResults": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${SignboardAgentFunction}",
        "Payload": {
          "action": "merge_results",
          "sessionId.$": "$.sessionId",
          "dalleResult.$": "$[0].dalleResult",
          "sdxlResult.$": "$[1].sdxlResult",
          "geminiResult.$": "$[2].geminiResult"
        }
      },
      "ResultPath": "$.mergedResults",
      "TimeoutSeconds": 10,
      "Next": "UpdateSession"
    },
    "UpdateSession": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${SupervisorAgentFunction}",
        "Payload": {
          "action": "update_session",
          "sessionId.$": "$.sessionId",
          "step": 3,
          "signboardImages.$": "$.mergedResults.Payload.signboards",
          "status": "signboards_generated"
        }
      },
      "ResultPath": "$.updateResult",
      "TimeoutSeconds": 5,
      "End": true
    }
  }
}